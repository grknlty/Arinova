# Local development works without these using .data/store.json and an explicit demo banner.
# Configure values in Vercel; never commit secrets.
# Set DATABASE_URL or use the Supabase integration’s POSTGRES_URL.
# Parent/learner passwords and SESSION_SECRET are required; IMPORT_API_TOKEN enables API imports.
DATABASE_URL=
POSTGRES_URL=
PARENT_PASSWORD=
LEARNER_PASSWORD=
SESSION_SECRET=
IMPORT_API_TOKEN=
